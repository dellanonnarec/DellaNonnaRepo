{
  "name": "della-nonna-pizzaria",
  "productName": "Della Nonna Pedidos",
  "description": "Central desktop de pedidos e impressão da Della Nonna",
  "author": "Della Nonna",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:desktop": "tsc -b && vite build --mode desktop",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop:dev": "concurrently -k -s first \"vite --mode desktop --host 127.0.0.1\" \"wait-on http://localhost:5173 && electron .\"",
    "desktop:dir": "npm run build:desktop && electron-builder --win dir",
    "desktop:installer": "npm run build:desktop && electron-builder --win nsis"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "iconv-lite": "^0.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.46.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router": "^8.4.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "br.com.dellanonna.pedidos",
    "productName": "Della Nonna Pedidos",
    "asar": false,
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "printing-agent/src/receipt.mjs", "package.json", "node_modules/iconv-lite/**/*", "node_modules/safer-buffer/**/*"],
    "extraResources": [
      { "from": "printing-agent/src/print-raw.ps1", "to": "printing/print-raw.ps1" }
    ],
    "win": {
      "signExecutable": false,
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "Della-Nonna-Pedidos-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Della Nonna Pedidos"
    }
  }
}
